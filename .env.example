# Copy this file to .env, adjust the values, then load it with:
#   set -a; source .env; set +a
#
# Provider credentials are intentionally not listed here. Configure them using
# OpenClaude's supported local authentication mechanism.

OPENCLAUDE_PROVIDER=openrouter

MODEL_GENERAL=google/gemini-2.5-flash
MODEL_REASONING=google/gemini-2.5-flash
MODEL_DOCUMENTATION=google/gemini-2.5-flash
MODEL_REGRESSION=cohere/north-mini-code:free

OPENAI_TEMPERATURE=0.2
OPENROUTER_TIMEOUT=300
OPENROUTER_MAX_RETRIES=3